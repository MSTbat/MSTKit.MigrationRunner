<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>MSTKit.MigrationRunner</PackageId>
        <Version>1.0.2</Version> 
        <Authors>MSTbat</Authors>
        <Company>MST</Company>
        <Description>A beautiful, Enterprise-grade standalone FluentMigrator runner powered by Spectre.Console.</Description>
        <RepositoryUrl>https://github.com/mstbat/MSTKit.MigrationRunner</RepositoryUrl>
        <Tags>fluentmigrator;database;spectre-console;cli;migrations</Tags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentMigrator.Runner.Core" Version="8.0.1"/>
        <PackageReference Include="FluentMigrator.Runner.SqlServer" Version="8.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13"/>
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
